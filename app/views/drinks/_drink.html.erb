<div id="<%= dom_id drink %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Name:</strong>
    <%= drink.name %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Barcode:</strong>
    <%= drink.barcode %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Price:</strong>
    <%= drink.price %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Volume:</strong>
    <%= drink.volume %>
  </div>
</div>
